# Copier ce fichier en .env et le compléter. Ne jamais publier le fichier .env.

# Adresse publique du site (sert aux URL de retour K-PAY)
PUBLIC_URL=https://votre-domaine.cm
PORT=3000
# Mettre 1 si le serveur tourne derrière un proxy (Nginx, hébergeur Node…)
TRUST_PROXY=1

# --- K-PAY (tableau de bord K-PAY > Applications) ---
KPAY_API_BASE=https://admin.kpay.site
# Clé publique : kpay_test_… en test, kpay_live_… en production
KPAY_API_KEY=
# Clé secrète (64 caractères hexadécimaux, affichée une seule fois à sa création)
KPAY_SECRET_KEY=
# Secret de signature de la page de paiement (paramètre « sig » de l'URL de retour)
KPAY_GATEWAY_SECRET=
# Secret de signature des webhooks (en-tête X-KPAY-Signature)
KPAY_WEBHOOK_SECRET=

# --- E-mails de confirmation (facultatif : sans SMTP, ils sont seulement journalisés) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=OKU <commandes@votre-domaine.cm>
# Adresse qui reçoit une alerte à chaque commande
SHOP_NOTIFY_EMAIL=

# --- Tests en local avec le faux K-PAY (npm run mock:kpay) ---
# KPAY_API_BASE=http://localhost:4010
# KPAY_API_KEY=kpay_test_local
# KPAY_SECRET_KEY=local
# KPAY_GATEWAY_SECRET=gateway-secret-test
# KPAY_WEBHOOK_SECRET=webhook-secret-test
